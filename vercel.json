{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    { "source": "/_next/static/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] }
  ],
  "redirects": [
    { "source": "/our-work/fix-flip/", "destination": "/fix-flip/", "permanent": true },
    { "source": "/our-work/brrrr/", "destination": "/brrrr/", "permanent": true },
    { "source": "/hello-world/", "destination": "/guides/", "permanent": true },
    { "source": "/contact", "destination": "/contact/", "permanent": true }
  ]
}
